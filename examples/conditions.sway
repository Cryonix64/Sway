// Conditional statements
func max(a: Int, b: Int) -> Int {
    if a > b {
        return a
    } else {
        return b
    }
}

func main() -> Void {
    let result = max(a: 5, b: 10)
    print(result)
    
    let x: Int = 15
    if x > 10 {
        print(1)
    } else if x == 10 {
        print(0)
    } else {
        print(-1)
    }
}
